<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        SargO flavor manifest.
        This merges with src/main/AndroidManifest.xml. It contains the same UI surface
        as src/ui/AndroidManifest.xml plus the SargO-specific entry point and receiver.

        The SargO launcher is treated as a separate application. This flavor communicates
        with it only through standard Android APIs (ContentProvider, BroadcastReceiver)
        so that the launcher has no compile-time dependency on the GPL-licensed
        ics-openvpn code.
    -->

    <!--
        REQUIRED TO READ THE LAUNCHER'S CONFIGURATION, and its absence is not a build error
        anywhere. The launcher declares pro.sargo.permission.READ_VPN_CONFIG at
        protectionLevel="signature" and guards its VpnConfigProvider
        (content://pro.sargo.launcher.vpn) with it. A signature permission is granted only when
        the consumer DECLARES it here AND the signatures match. Ours do match, so this line is
        the whole of what was missing.

        Without it, contentResolver.query() on that authority throws SecurityException on the
        device, while this repository and the launcher's both stay green, because neither build
        can see the other half of the contract.

        NOT the same permission as PUSH_CONFIG on the receiver below, and the two are not
        interchangeable. PUSH_CONFIG means "you may be told the configuration changed";
        READ_VPN_CONFIG means "you may read it", and those rows carry VPN credentials.
        Conflating them would let anything allowed to hear a ping also read a password.
    -->
    <uses-permission android:name="pro.sargo.permission.READ_VPN_CONFIG" />

    <!--
        Package visibility only. This lets the app SEE the provider; it does not grant access to
        it. Having this without the permission above is exactly the state that produced the
        silent failure described there.
    -->
    <queries>
        <provider android:authorities="pro.sargo.launcher.vpn" />
    </queries>

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- This library wants SDK version 23 but we do runtime checks to not use it before API 23 -->
    <uses-sdk tools:overrideLibrary="androidx.security"/>

    <application android:banner="@mipmap/banner_tv">
        <!--
            Entry point for SargO-managed OpenVPN.
            This activity is launched by the SargO launcher or on boot.
        -->
        <activity
            android:name=".sargo.SargoLauncherActivity"
            android:exported="true"
            android:theme="@style/SargO.Launcher"
            android:label="@string/app">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Config update receiver. Restricted to broadcasts sent by the SargO launcher
            via its signature-level permission so arbitrary apps cannot trigger VPN reloads.
        -->
        <receiver
            android:name=".sargo.SargoConfigReceiver"
            android:exported="true"
            android:permission="pro.sargo.permission.PUSH_CONFIG">
            <intent-filter>
                <action android:name="pro.sargo.push.configUpdated" />
            </intent-filter>
        </receiver>
        <!--
            Standard ics-openvpn UI activities (mirrored from src/ui/AndroidManifest.xml).
            In the SargO flavor these are kept internal only; external profile import paths
            are removed so the MDM channel is the only way to provision VPN configs.
        -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.SargO.OpenVPN"
            tools:node="replace" />

        <activity
            android:name=".activities.ConfigConverter"
            tools:node="remove" />

        <activity-alias
            android:name=".activities.ConfigConverterFile"
            tools:node="remove" />

        <activity
            android:name=".activities.CreateShortcuts"
            tools:node="remove" />

        <activity
            android:name=".activities.CredentialsPopup"
            android:theme="@style/SargO.Dialog" />

        <activity
            android:name=".activities.LogWindow"
            android:allowTaskReparenting="true"
            android:label="@string/openvpn_log"
            android:launchMode="singleTask" />

        <activity
            android:name=".activities.VPNPreferences"
            android:exported="false"
            android:windowSoftInputMode="stateHidden" />

        <activity android:name=".activities.FileSelect" />

        <activity
            android:name=".activities.OpenSSLSpeed"
            android:exported="false"
            android:label="@string/title_activity_open_sslspeed"
            android:parentActivityName=".activities.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="de.blinkt.openvpn.activities.MainActivity" />
        </activity>

        <!--
            Quick Settings tile is disabled in the SargO flavor. The VPN is managed
            remotely and, when allow_user_disconnect=false, kept connected by
            always-on VPN lockdown. Allowing the tile would let the user toggle
            the connection independently of the MDM policy.
        -->
        <service
            android:exported="true"
            android:name=".OpenVPNTileService"
            android:enabled="false"
            android:icon="@drawable/ic_quick"
            android:label="@string/qs_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:value="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!--
            FileProvider is not required for the SargO-managed flow. Keep it disabled
            for external apps to reduce the attack surface of the SargO flavor.
        -->
        <provider
            android:name=".FileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
